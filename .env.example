# Nova backend configuration. Copy to ".env" (project root or backend/) and edit.
# Every value is optional – Nova runs fully offline with the defaults.

# --- General ----------------------------------------------------------------
NOVA_LOG_LEVEL=INFO
NOVA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# NOVA_DATABASE_URL=sqlite:///S:/path/to/nova.db   # default: backend/data/nova.db

# --- Behaviour --------------------------------------------------------------
# Open allow-listed websites with the OS default browser (backend runs locally).
# Set to false to let the browser tab open the link instead.
NOVA_OPEN_BROWSER_ON_SERVER=true
# Train the intent model automatically on start-up if artifacts/intent_model.joblib is missing.
NOVA_AUTO_TRAIN_IF_MISSING=true

# --- Weather (Open-Meteo, free, no API key) ---------------------------------
# Needs internet. Set your default city in the app's Settings page.
NOVA_WEATHER_ENABLED=true

# --- Optional conversational AI for general questions -------------------------
# Leave NOVA_LLM_PROVIDER empty to use only the offline knowledge base.
#   anthropic -> Claude via the official SDK (needs ANTHROPIC_API_KEY)
#   ollama    -> a local model served by Ollama (free, offline): https://ollama.com
NOVA_LLM_PROVIDER=
# NOVA_LLM_MODEL=claude-opus-5-5        # anthropic default; ollama default is llama3.2
# ANTHROPIC_API_KEY=sk-ant-...           # backend only – never exposed to the frontend
# NOVA_OLLAMA_BASE_URL=http://localhost:11434
